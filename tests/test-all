#!/usr/bin/env bash

# dave hates this, but damn if it's not effective
# https://blog.daveeddy.com/2015/04/13/dirname-case-study-for-bash-and-node/
CDPATH='' cd -- "$(dirname -- "$0")/.." || exit 1

files=(./contributors/*.txt)
count=${#files[@]}
./tools/validate-file "${files[@]}"
code=$?

echo
echo "found $count contributors"

if ((code == 0)); then
	echo 'all contributors valid'
else
	echo 'errors found'
fi

exit "$code"
